# Template for backend/.env (which is gitignored -- never commit real
# secrets). Copy this file to ".env" in this same folder and fill in
# real values:
#   cp .env.example .env

# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Where the precomputed movie data lives, relative to backend/. Leave as
# the default unless you've moved scripts/build_processed_dataset.py's output.
MOVIES_DATA_DIR=data/processed

# Which frontend URL(s) are allowed to call this API from a browser.
# Comma-separated, no spaces needed around commas. Add your deployed
# frontend's URL here once you have one.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
