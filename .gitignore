# Tells git which files/folders to never track. Nothing listed here gets
# committed, even with `git add .` -- mostly things that are either
# regenerable (installed packages, caches) or secret (.env files).

# Python: virtual environment and bytecode caches, regenerated by
# `pip install -r requirements.txt` -- no need to commit them.
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Data (raw Kaggle dataset is ~230MB, exceeds GitHub's 100MB file limit --
# only the small precomputed dataset in data/processed/ is tracked)
backend/data/*
!backend/data/.gitkeep
!backend/data/processed/

# Env: files holding secrets (API keys) and machine-specific settings.
# backend/.env.example and frontend/.env.example ARE committed as
# templates -- copy them to .env and fill in real values locally.
.env
backend/.env

# Node: installed packages and the production build output, both
# regenerated by `npm install` / `npm run build` -- no need to commit them.
frontend/node_modules/
frontend/dist/

# OS: macOS Finder metadata file, not part of the project.
.DS_Store
