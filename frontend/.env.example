# Template for frontend/.env (gitignored). Copy to ".env" for a local
# override, or set this as an environment variable in Vercel's dashboard
# when deploying.
#
# Not needed for local development against a local backend -- Vite's dev
# server proxies "/api" to localhost:8000 automatically (see
# vite.config.js), so this only matters once the frontend is deployed
# separately from the backend and needs to know its real URL.
VITE_API_BASE_URL=https://your-backend.onrender.com/api
